<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#071d3d">
<title>Klinik CG — Démonstration partenaire</title>
<style>
:root{--navy:#071d3d;--blue:#1677ff;--teal:#18a99b;--ink:#10294e;--muted:#71819c;--line:#e4eaf3;--bg:#f4f7fb;--card:#fff;--shadow:0 18px 55px rgba(12,38,75,.10)}
*{box-sizing:border-box}body{margin:0;background:linear-gradient(145deg,#edf5ff,#fff 45%,#f5f8fc);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;color:var(--ink)}
button,input,select{font:inherit}button{border:0;cursor:pointer}.top{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.92);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}
.nav{max-width:1180px;margin:auto;padding:13px 22px;display:flex;align-items:center;justify-content:space-between;gap:14px}.brand{display:flex;align-items:center;gap:10px;font-size:23px;font-weight:900}.brand em{font-style:normal;color:var(--teal)}
.mark{width:44px;height:44px;border-radius:14px;background:linear-gradient(145deg,#087dff,#19b4a2);display:grid;place-items:center;color:#fff;font-size:28px;font-weight:900}
.demo{background:#fff4d9;color:#765a20;padding:9px 13px;border-radius:999px;font-size:11px;font-weight:900;letter-spacing:1px}.switch{background:#eef3fa;color:var(--ink);padding:11px 15px;border-radius:13px;font-weight:850}
.hero{max-width:1180px;margin:auto;padding:58px 22px 32px}.eyebrow{font-size:12px;letter-spacing:4px;font-weight:900;color:#617897}.hero h1{font-size:clamp(45px,7vw,78px);line-height:.96;letter-spacing:-4px;margin:10px 0 18px}.hero h1 em{font-style:normal;color:var(--teal)}.hero p{max-width:700px;color:var(--muted);font-size:19px;line-height:1.55;margin:0}.line{height:5px;width:82px;border-radius:8px;background:linear-gradient(90deg,var(--teal),var(--blue));margin:22px 0}
.profiles{max-width:1180px;margin:auto;padding:10px 22px 26px;display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.profile{background:rgba(255,255,255,.97);border:1px solid var(--line);border-radius:27px;padding:27px;box-shadow:var(--shadow);display:flex;flex-direction:column;min-height:310px}.profile .ico{width:65px;height:65px;border-radius:20px;background:#edf4ff;display:grid;place-items:center;font-size:33px;margin-bottom:20px}.profile h2{margin:0 0 9px;font-size:29px}.profile p{color:var(--muted);line-height:1.5;min-height:48px}.list{border-top:1px solid var(--line);padding-top:14px;display:grid;gap:8px;font-size:14px;font-weight:750}.go{margin-top:auto;padding:14px 18px;border-radius:14px;background:linear-gradient(100deg,var(--blue),#3290ff);color:white;font-weight:900}
.admin{max-width:1180px;margin:auto;padding:0 22px 36px}.adminbox{background:#fff;border:1px solid var(--line);border-radius:25px;padding:22px 26px;display:flex;align-items:center;gap:18px;box-shadow:var(--shadow)}.adminbox h2{margin:0 0 4px}.adminbox p{margin:0;color:var(--muted)}.adminbox button{margin-left:auto;background:var(--navy);color:#fff;padding:13px 18px;border-radius:13px;font-weight:900}
.app{display:none}.app.active{display:block}.screen{max-width:1180px;margin:auto;padding:26px 22px 55px}.apphead{display:flex;justify-content:space-between;align-items:flex-start;gap:15px;margin-bottom:22px}.apphead h1{margin:0;font-size:32px}.apphead p{margin:5px 0;color:var(--muted)}.back{background:#fff;border:1px solid var(--line);padding:10px 14px;border-radius:12px;font-weight:850}
.layout{display:grid;grid-template-columns:235px 1fr;gap:18px}.side{background:#fff;border:1px solid var(--line);border-radius:20px;padding:10px;height:max-content;box-shadow:var(--shadow)}.side button{width:100%;text-align:left;background:transparent;padding:12px;border-radius:11px;color:var(--ink);font-weight:800}.side button.active{background:#edf4ff;color:var(--blue)}
.main{min-width:0}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;margin-bottom:16px}.stat,.panel{background:#fff;border:1px solid var(--line);border-radius:19px;box-shadow:var(--shadow)}.stat{padding:17px}.stat small{color:var(--muted)}.stat strong{display:block;font-size:25px;margin-top:6px}.panel{padding:21px;margin-bottom:15px}.panel h2{margin:0 0 15px;font-size:20px}
.row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 0;border-bottom:1px solid var(--line)}.row:last-child{border-bottom:0}.row b{display:block}.row span{display:block;color:var(--muted);font-size:13px;margin-top:3px}.badge{display:inline-block!important;background:#e7f7f3;color:#087e70!important;padding:5px 9px;border-radius:999px;font-size:11px!important;font-weight:900}.primary{background:var(--blue);color:#fff;padding:11px 14px;border-radius:11px;font-weight:900;white-space:nowrap}.teal{background:var(--teal);color:#fff;padding:11px 14px;border-radius:11px;font-weight:900}.search{display:flex;gap:9px;margin-bottom:12px}.search input{width:100%;padding:13px;border:1px solid #d8e1ed;border-radius:12px;outline:none}.steps{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:17px}.step{padding:8px 11px;border-radius:999px;background:#edf2f8;color:#667895;font-size:12px;font-weight:850}.step.done{background:#e5f7f3;color:#087d70}.step.current{background:#eaf1ff;color:var(--blue)}.notice{padding:13px 15px;border-radius:13px;background:#f0f6ff;color:#284b7a;margin-bottom:14px;font-size:13px}.table{width:100%;border-collapse:collapse}.table th,.table td{text-align:left;padding:11px 7px;border-bottom:1px solid var(--line);font-size:13px}
.footer{text-align:center;color:var(--muted);font-size:12px;padding:8px 22px 28px}.modal{display:none;position:fixed;inset:0;background:rgba(5,20,45,.55);z-index:50;place-items:center;padding:18px}.modal.show{display:grid}.box{background:#fff;width:min(520px,100%);border-radius:24px;padding:24px;box-shadow:0 30px 90px rgba(0,0,0,.25)}.box h2{margin-top:0}.field{margin:12px 0}.field label{display:block;font-size:12px;font-weight:850;margin-bottom:6px}.field input,.field select{width:100%;padding:12px;border:1px solid #d8e1ed;border-radius:11px}.actions{display:flex;justify-content:flex-end;gap:9px;margin-top:18px}.ghost{padding:11px 14px;border-radius:11px;background:#edf2f8;font-weight:800}.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,20px);opacity:0;background:var(--navy);color:#fff;padding:12px 17px;border-radius:999px;font-weight:800;z-index:80;transition:.25s}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:850px){.profiles{grid-template-columns:1fr}.layout{grid-template-columns:1fr}.side{display:flex;overflow:auto;gap:4px}.side button{min-width:max-content}.stats{grid-template-columns:1fr}.adminbox{flex-wrap:wrap}.adminbox button{margin-left:0;width:100%}.demo{display:none}}
@media(max-width:480px){.nav{padding:10px 15px}.brand{font-size:19px}.mark{width:40px;height:40px}.hero{padding:40px 16px 25px}.hero h1{font-size:48px}.profiles,.admin,.screen{padding-left:16px;padding-right:16px}.profile{padding:22px}.apphead h1{font-size:26px}.table{font-size:11px}.table th,.table td{padding:8px 4px}}
</style>
</head>
<body>
<header class="top"><div class="nav"><div class="brand"><div class="mark">+</div><div>Klinik <em>CG</em></div></div><div class="demo">PARTNER DEMO · DONNÉES FICTIVES</div><button class="switch" onclick="goHome()">Changer de profil</button></div></header>

<main id="home">
<section class="hero"><div class="eyebrow">PLATEFORME HEALTH &amp; CARE</div><h1>Klinik <em>CG</em></h1><div class="line"></div><p>Une expérience de santé connectée où le patient, le médecin et la clinique partagent le même parcours — du rendez-vous jusqu’au paiement et au suivi.</p></section>
<section class="profiles">
<article class="profile"><div class="ico">👤</div><h2>Patient</h2><p>Rechercher, réserver, consulter son dossier et payer.</p><div class="list"><div>🔎 Recherche d’établissement</div><div>📅 Rendez-vous</div><div>📁 Dossier médical</div><div>💳 Paiements</div></div><button class="go" onclick="openApp('patient')">Entrer dans l’espace →</button></article>
<article class="profile"><div class="ico">🩺</div><h2>Médecin</h2><p>Recevoir ses rendez-vous, consulter les patients et documenter les consultations.</p><div class="list"><div>🗓️ Agenda</div><div>👥 Patients</div><div>📋 Consultation</div><div>🧾 Compte rendu</div></div><button class="go" onclick="openApp('doctor')">Entrer dans l’espace →</button></article>
<article class="profile"><div class="ico">🏥</div><h2>Clinique</h2><p>Piloter l’activité, les médecins, les rendez-vous et la facturation.</p><div class="list"><div>📅 Rendez-vous</div><div>👨‍⚕️ Médecins</div><div>📊 Activité</div><div>💳 Facturation</div></div><button class="go" onclick="openApp('clinic')">Entrer dans l’espace →</button></article>
</section>
<section class="admin"><div class="adminbox"><div style="font-size:31px">🛡️</div><div><h2>Administration</h2><p>Vue globale : utilisateurs, établissements, activité et paiements.</p></div><button onclick="openApp('admin')">Pilotage →</button></div></section>
<div class="footer">Klinik CG · démonstration partenaire · toutes les données sont fictives</div>
</main>

<section id="patient" class="app"><div class="screen"><div class="apphead"><div><h1>Espace Patient</h1><p>Jean Mavoungou · parcours connecté</p></div><button class="back" onclick="goHome()">← Profils</button></div>
<div class="steps"><span class="step current" id="ps1">1 Recherche</span><span class="step" id="ps2">2 Rendez-vous</span><span class="step" id="ps3">3 Paiement</span><span class="step" id="ps4">4 Confirmation</span></div>
<div class="layout"><nav class="side"><button class="active" onclick="patientOverview()">Vue d’ensemble</button><button onclick="patientSearch()">🔎 Rechercher</button><button onclick="patientAppointments()">📅 Rendez-vous</button><button onclick="patientFile()">📁 Dossier</button><button onclick="patientPayments()">💳 Paiements</button></nav><div class="main" id="patientMain"></div></div></div></section>

<section id="doctor" class="app"><div class="screen"><div class="apphead"><div><h1>Espace Médecin</h1><p>Dr. Alain M. · Cardiologie</p></div><button class="back" onclick="goHome()">← Profils</button></div>
<div class="layout"><nav class="side"><button class="active" onclick="doctorOverview()">Vue d’ensemble</button><button onclick="doctorAgenda()">🗓️ Agenda</button><button onclick="doctorPatients()">👥 Patients</button><button onclick="doctorConsult()">📋 Consultation</button></nav><div class="main" id="doctorMain"></div></div></div></section>

<section id="clinic" class="app"><div class="screen"><div class="apphead"><div><h1>Espace Clinique</h1><p>Netcare · Pointe-Noire · établissement partenaire</p></div><button class="back" onclick="goHome()">← Profils</button></div>
<div class="layout"><nav class="side"><button class="active" onclick="clinicOverview()">Vue d’ensemble</button><button onclick="clinicAppointments()">📅 Rendez-vous</button><button onclick="clinicDoctors()">👨‍⚕️ Médecins</button><button onclick="clinicBilling()">💳 Facturation</button></nav><div class="main" id="clinicMain"></div></div></div></section>

<section id="admin" class="app"><div class="screen"><div class="apphead"><div><h1>Administration</h1><p>Klinik CG · pilotage global</p></div><button class="back" onclick="goHome()">← Profils</button></div><div class="main" id="adminMain"></div></div></section>

<div class="modal" id="modal"><div class="box" id="modalBox"></div></div><div class="toast" id="toast"></div>
<script>
const state={booking:false,paid:false,consulted:false};
const money=n=>new Intl.NumberFormat('fr-FR').format(n)+' FCFA';
const panel=(t,b)=>`<div class="panel"><h2>${t}</h2>${b}</div>`;
const stats=a=>`<div class="stats">${a.map(x=>`<div class="stat"><small>${x[0]}</small><strong>${x[1]}</strong></div>`).join('')}</div>`;
function goHome(){document.querySelectorAll('.app').forEach(x=>x.classList.remove('active'));document.getElementById('home').style.display='block';window.scrollTo(0,0)}
function openApp(p){document.getElementById('home').style.display='none';document.querySelectorAll('.app').forEach(x=>x.classList.remove('active'));document.getElementById(p).classList.add('active');({patient:patientOverview,doctor:doctorOverview,clinic:clinicOverview,admin:adminOverview}[p])();window.scrollTo(0,0)}

function patientOverview(){document.getElementById('patientMain').innerHTML=stats([['Prochain rendez-vous','12 sept. · 10:30'],['Dossier','À jour'],['À payer',state.paid?'0 FCFA':'25 000 FCFA']])+panel('Votre parcours',`<div class="notice">Le même dossier circule entre le patient, le médecin et la clinique. Cette démonstration suit un parcours complet.</div><div class="row"><div><b>1 · Trouver Netcare</b><span>Clinique partenaire · Pointe-Noire</span></div><button class="primary" onclick="patientSearch()">Rechercher</button></div><div class="row"><div><b>2 · Réserver avec Dr. Alain M.</b><span>Cardiologie · 12 septembre · 10:30</span></div><span class="badge">Disponible</span></div><div class="row"><div><b>3 · Payer la consultation</b><span>25 000 FCFA · paiement simulé</span></div><span class="badge">${state.paid?'Payé':'À faire'}</span></div>`)}

function patientSearch(){document.getElementById('patientMain').innerHTML=panel('Rechercher un établissement',`<div class="search"><input id="q" placeholder="Clinique, spécialité ou ville…" oninput="searchClinic()"><button class="primary" onclick="searchClinic()">Rechercher</button></div><div id="results"><div class="row"><div><b>🏥 Netcare</b><span>Pointe-Noire · Cardiologie · Médecine générale · ⭐ 4,8</span></div><button class="primary" onclick="book()">Voir &amp; réserver</button></div></div>`)}
function searchClinic(){const q=(document.getElementById('q').value||'').toLowerCase();document.getElementById('results').innerHTML=!q||'netcare pointe-noire cardiologie médecine générale'.includes(q)?`<div class="row"><div><b>🏥 Netcare</b><span>Pointe-Noire · Cardiologie · Médecine générale · ⭐ 4,8</span></div><button class="primary" onclick="book()">Voir &amp; réserver</button></div>`:`<div class="notice">Aucun autre établissement dans les données de cette démonstration.</div>`}
function book(){openModal(`<h2>Réserver chez Netcare</h2><p style="color:var(--muted)">Dr. Alain M. · Cardiologie</p><div class="field"><label>Date</label><input type="date" value="2026-09-12"></div><div class="field"><label>Créneau</label><select><option>10:30</option><option>11:00</option><option>14:30</option></select></div><div class="actions"><button class="ghost" onclick="closeModal()">Annuler</button><button class="primary" onclick="confirmBooking()">Confirmer le rendez-vous</button></div>`)}
function confirmBooking(){state.booking=true;closeModal();toast('Rendez-vous confirmé · Netcare · 12 sept. 10:30');setSteps(2);patientAppointments()}
function patientAppointments(){document.getElementById('patientMain').innerHTML=panel('Mes rendez-vous',`<div class="notice">Rendez-vous créé dans le dossier partagé Klinik CG. Le médecin et Netcare le voient maintenant.</div><div class="row"><div><b>12 sept. 2026 · 10:30</b><span>Dr. Alain M. · Cardiologie · Netcare</span></div><span class="badge">${state.booking?'Confirmé':'À confirmer'}</span></div>${!state.paid?`<div class="row"><div><b>Paiement de la consultation</b><span>25 000 FCFA</span></div><button class="teal" onclick="pay()">Payer</button></div>`:''}`)}
function pay(){openModal(`<h2>Paiement sécurisé</h2><div class="notice">Montant à régler : <b>25 000 FCFA</b><br>Simulation — aucune transaction réelle.</div><div class="field"><label>Mode de paiement</label><select><option>Mobile Money</option><option>Carte bancaire</option><option>Espèces au cabinet</option></select></div><div class="actions"><button class="ghost" onclick="closeModal()">Annuler</button><button class="teal" onclick="confirmPay()">Confirmer le paiement</button></div>`)}
function confirmPay(){state.paid=true;closeModal();setSteps(3);toast('Paiement enregistré · reçu généré');setTimeout(()=>{setSteps(4);patientPayments()},500)}
function patientFile(){document.getElementById('patientMain').innerHTML=panel('Mon dossier médical',`<div class="row"><div><b>Patient</b><span>Jean Mavoungou · dossier KCG-10284</span></div><span class="badge">Actif</span></div><div class="row"><div><b>Dernière consultation</b><span>12 août 2026 · Cardiologie</span></div></div><div class="row"><div><b>Documents</b><span>2 comptes rendus · 1 ordonnance</span></div><button class="primary" onclick="toast('Document ouvert dans la simulation')">Ouvrir</button></div>`)}
function patientPayments(){document.getElementById('patientMain').innerHTML=panel('Mes paiements',`<div class="row"><div><b>12/09/2026 · Consultation cardiologie</b><span>Netcare · reçu KCG-PAY-0912</span></div><div><b>${money(25000)}</b><span class="badge">${state.paid?'Payé':'En attente'}</span></div></div><div class="row"><div><b>01/07/2026 · Consultation</b><span>Netcare</span></div><div><b>${money(15000)}</b><span class="badge">Payé</span></div></div>`)}
function setSteps(n){for(let i=1;i<=4;i++){const e=document.getElementById('ps'+i);e.classList.toggle('done',i<n);e.classList.toggle('current',i===n)}}

function doctorOverview(){document.getElementById('doctorMain').innerHTML=stats([['Aujourd’hui','6 patients'],['Rendez-vous','24 / semaine'],['Paiements liés','25 000 FCFA']])+panel('Nouveau rendez-vous',`<div class="notice">Un nouveau rendez-vous vient d’être créé par <b>Jean Mavoungou</b> depuis l’espace Patient.</div><div class="row"><div><b>10:30 · Jean Mavoungou</b><span>Cardiologie · Netcare · dossier KCG-10284</span></div><span class="badge">Confirmé</span></div><div class="row"><div><b>14:30 · Patrick Samba</b><span>Première consultation</span></div><span class="badge">Confirmé</span></div>`)}
function doctorAgenda(){doctorOverview()}
function doctorPatients(){document.getElementById('doctorMain').innerHTML=panel('Mes patients',`<div class="search"><input placeholder="Rechercher un patient…"><button class="primary">Rechercher</button></div><div class="row"><div><b>Jean Mavoungou</b><span>KCG-10284 · dernière visite 12/08/2026</span></div><button class="primary" onclick="doctorConsult()">Ouvrir</button></div><div class="row"><div><b>Marie Okemba</b><span>KCG-10172 · dernière visite 28/08/2026</span></div><button class="primary">Ouvrir</button></div>`)}
function doctorConsult(){document.getElementById('doctorMain').innerHTML=panel('Consultation · Jean Mavoungou',`<div class="notice">Le patient a réservé depuis Klinik CG. Le paiement est ${state.paid?'confirmé':'en attente'}.</div><div class="row"><div><b>Motif</b><span>Suivi cardiologique</span></div></div><div class="row"><div><b>Constantes</b><span>TA 128/82 · FC 72 · SpO₂ 98%</span></div></div><div class="row"><div><b>Compte rendu</b><span>Consultation du 12/09/2026</span></div><button class="primary" onclick="completeConsult()">Valider</button></div>`)}
function completeConsult(){state.consulted=true;toast('Consultation enregistrée dans le dossier patient');setTimeout(()=>openApp('clinic'),500)}

function clinicOverview(){document.getElementById('clinicMain').innerHTML=stats([['Rendez-vous aujourd’hui','32'],['Médecins actifs','18'],['CA du mois',money(4850000)])+panel('Netcare · activité en temps réel',`<div class="row"><div><b>Jean Mavoungou · 10:30</b><span>Cardiologie · Dr. Alain M.</span></div><span class="badge">${state.booking?'Confirmé':'Nouveau'}</span></div><div class="row"><div><b>Paiement consultation</b><span>25 000 FCFA · Jean Mavoungou</span></div><span class="badge">${state.paid?'Payé':'En attente'}</span></div><div class="row"><div><b>Consultation</b><span>Compte rendu médical</span></div><span class="badge">${state.consulted?'Terminée':'À venir'}</span></div>`)}
function clinicAppointments(){document.getElementById('clinicMain').innerHTML=panel('Rendez-vous Netcare',`<div class="row"><div><b>12/09 · 10:30 · Jean Mavoungou</b><span>Dr. Alain M. · Cardiologie</span></div><span class="badge">${state.booking?'Confirmé':'Nouveau'}</span></div><div class="row"><div><b>12/09 · 14:30 · Patrick Samba</b><span>Dr. Sarah Mouanda · Médecine générale</span></div><span class="badge">Confirmé</span></div>`)}
function clinicDoctors(){document.getElementById('clinicMain').innerHTML=panel('Médecins',`<div class="row"><div><b>Dr. Alain M.</b><span>Cardiologie · 24 créneaux/semaine</span></div><span class="badge">Actif</span></div><div class="row"><div><b>Dr. Sarah Mouanda</b><span>Médecine générale · 30 créneaux/semaine</span></div><span class="badge">Actif</span></div>`)}
function clinicBilling(){document.getElementById('clinicMain').innerHTML=panel('Facturation',`<table class="table"><tr><th>Référence</th><th>Patient</th><th>Prestation</th><th>Montant</th><th>Statut</th></tr><tr><td>KCG-0912</td><td>Jean Mavoungou</td><td>Cardiologie</td><td>${money(25000)}</td><td><span class="badge">${state.paid?'Payé':'En attente'}</span></td></tr><tr><td>KCG-0911</td><td>Marie Okemba</td><td>Consultation</td><td>${money(15000)}</td><td><span class="badge">Payé</span></td></tr></table>`)}

function adminOverview(){document.getElementById('adminMain').innerHTML=stats([['Patients','1 284'],['Médecins','86'],['Cliniques','14']])+panel('Vue globale Klinik CG',`<div class="notice">La démonstration montre comment une action du patient alimente les espaces médecin et clinique.</div><div class="row"><div><b>Patient → Rendez-vous</b><span>Jean Mavoungou · Netcare · 10:30</span></div><span class="badge">${state.booking?'Créé':'En attente'}</span></div><div class="row"><div><b>Paiement → Facturation</b><span>25 000 FCFA</span></div><span class="badge">${state.paid?'Payé':'En attente'}</span></div><div class="row"><div><b>Consultation → Dossier</b><span>Dr. Alain M.</span></div><span class="badge">${state.consulted?'Enregistrée':'À venir'}</span></div>`)}

function openModal(h){document.getElementById('modalBox').innerHTML=h;document.getElementById('modal').classList.add('show')}
function closeModal(){document.getElementById('modal').classList.remove('show')}
function toast(t){const e=document.getElementById('toast');e.textContent=t;e.classList.add('show');setTimeout(()=>e.classList.remove('show'),2400)}
goHome();
</script>
</body>
</html>
